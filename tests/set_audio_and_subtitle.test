#!/bin/sh
# Functional test for the `set_audio_and_subtitle` tool.
#
# Drives the real mcp-kodi binary over its MCP stdio transport against a live
# Kodi. `set_audio_and_subtitle` switches the audio track and/or subtitle of the
# video now playing, by the per-stream `index` that `audio_and_subtitle_info`
# reports (Player.SetAudioStream / Player.SetSubtitle on the active video
# player). `audio` and `subtitle` are each optional and applied only when given;
# `subtitle: "off"` hides subtitles, distinct from omitting it. The tool returns
# the standard player-state snapshot. This test exercises every caller mistake
# (each a clean tool error naming the fault), then starts a real movie, reads
# its streams with `audio_and_subtitle_info`, and drives audio / subtitle / off
# through the tool, asserting each returns a `playing` snapshot of the same item.
#
# Library-agnostic: it plays whatever movie the library actually holds, and only
# selects subtitle indices the item really carries (embedded subtitles are
# optional), so it passes against any *populated* video library.
#
# Preconditions (else the test SKIPs, automake exit 77):
#   - jq and curl on PATH
#   - the mcp-kodi binary built
#   - a reachable Kodi that answers JSONRPC.Ping with "pong"
#   - at least one movie in the library (else the playback assertions SKIP)
#
# Target Kodi defaults to the local test instance; override via the environment:
#   KODI_HOST=127.0.0.1:8080  KODI_AUTH=user:pass  KODI_SCHEME=http
#
# Since real playback may be audible on a real device, the test reads the volume
# at startup, lowers it to 2% for the run, and restores the original on exit.
#
# Exit: 0 all assertions passed · 1 a failure · 77 skipped.

set -u

# Shared harness: target-Kodi defaults, skip gates, kodi_rpc / mcp_tool, the jq
# helpers, and the ok/no/eq assertion framework. See tests/lib.sh.
. "$(dirname "$0")/lib.sh"

# Keep the playback this test triggers OUT of the user's real history log:
# history.json lives under XDG_STATE_HOME, so redirect it to a throwaway dir.
# (The EXIT cleanup is folded into the volume guard's trap, set below.)
STATE_DIR=$(mktemp -d) || { echo "SKIP: cannot mktemp"; exit 77; }
export XDG_STATE_HOME="$STATE_DIR"
trap 'rm -rf "$STATE_DIR"' EXIT

# Dependencies (jq, curl), locate the binary into $MCP, require a live Kodi.
mk_preflight

# ---- volume guard ----------------------------------------------------------
# The test starts real playback on a possibly real device, so remember the
# current volume, run quietly at 2%, and restore the original on every exit.
vol0=$(kodi_rpc Application.GetProperties '{"properties":["volume"]}' \
        | jq -r '.result.volume // empty')
restore_volume () {
  [ -n "$vol0" ] && kodi_rpc Application.SetVolume "{\"volume\":$vol0}" >/dev/null 2>&1
}
trap 'restore_volume; rm -rf "$STATE_DIR"' EXIT
[ -n "$vol0" ] && kodi_rpc Application.SetVolume '{"volume":2}' >/dev/null 2>&1

# ---- tool wrappers for this test ------------------------------------------
setas       () { mcp_tool set_audio_and_subtitle "$1"; }
info        () { mcp_tool audio_and_subtitle_info "$1"; }
searchmedia () { mcp_tool searchmedia             "$1"; }
playfile    () { mcp_tool playfile                "$1"; }
stop_t      () { mcp_tool stop                    "$1"; }

# A call that must fail: assert isError:true and that the message guides the
# caller — it names what was wrong and what to do instead.
setas_err () { # desc arguments-json expected-message-fragment
  b=$(setas "$2")
  eq "$1 -> tool error" true "$(res_err "$b")"
  contains "$1 -> message guides the caller" "$3" "$(g "$(res_body "$b")" '.error')"
}

echo "set_audio_and_subtitle functional test — Kodi at $KODI_SCHEME://$KODI_HOST, binary $MCP"

# ---- the volume guard took hold: Kodi reports the quiet test level ---------
echo "-- volume guard (was: ${vol0:-unknown}%)"
eq "volume lowered to 2% for the test run" 2 \
   "$(kodi_rpc Application.GetProperties '{"properties":["volume"]}' \
       | jq -r '.result.volume')"

# ===========================================================================
# 1. Argument errors first: each is a clean tool error (isError:true) whose
#    message names the fault and the accepted usage — none reaches playback.
# ===========================================================================
echo "-- errors / edges"

setas_err "neither audio nor subtitle" '{}' \
          'give at least one of "audio" or "subtitle"'
setas_err "subtitle as a bad string"   '{"subtitle":"on"}' \
          'stream index (integer) or "off"'

# An unconfigured instance is a communication failure: the error carries the
# no_instance category and a setup hint. A selector is supplied so the call
# clears the "give at least one" check and reaches instance resolution.
b=$(setas '{"instance":"no-such-box","audio":0}')
eq "unknown instance -> tool error" true "$(res_err "$b")"
eq "unknown instance -> category no_instance" no_instance \
   "$(g "$(res_body "$b")" '.category')"
is_true "unknown instance -> carries a setup hint" \
        "$(j "$(res_body "$b")" 'has("hint") and (.hint|length>0)')"

# ===========================================================================
# 2. Nothing playing: stop any active player, then the tool must refuse with
#    the "nothing is playing" error pointing at play/playfile.
# ===========================================================================
mk_wait_idle   # stop any player and wait for real idle (was a fixed sleep)

setas_err "set with nothing playing" '{"audio":0}' 'nothing is playing'

# ===========================================================================
# 3. Discover a movie via `searchmedia`; a movie-less library skips the rest
#    (still a pass — the error contract above is fully exercised).
# ===========================================================================
b=$(res_body "$(searchmedia '{"type":"movie","limit":1}')")
if [ "$(j "$b" '.returned >= 1')" != true ]; then
  echo "   (library holds no movies — playback assertions skipped)"
  mk_tally "set_audio_and_subtitle functional test"
fi

movieid=$(g "$b" '.rows[0].movieid')
file=$(g "$b" '.rows[0].file')
echo "-- playing movie $movieid"
echo "   ($file)"

# ===========================================================================
# 4. Start the movie, then read its embedded streams so we drive the setter
#    with indices the item actually carries.
# ===========================================================================
b=$(playfile "$(jargs --arg f "$file" '{file:$f}')")
eq "playfile starts the movie" false "$(res_err "$b")"

# Give Kodi a moment to spin up the video player before we drive its streams.
i=0
while [ "$i" -lt 10 ]; do
  ptype=$(kodi_rpc Player.GetActivePlayers '{}' | jq -r '.result[0].type // empty')
  [ "$ptype" = "video" ] && break
  sleep 1
  i=$((i + 1))
done
[ "$ptype" = "video" ] || skip "video player did not start"

streams=$(res_body "$(info "$(jargs --argjson i "$movieid" '{type:"movie",id:$i}')")")
naudio=$(j "$streams" '.audio | length')
nsub=$(j "$streams"   '.subtitle | length')
echo "   (embedded: $naudio audio, $nsub subtitle streams)"

# ===========================================================================
# 5. audio only: select an audio track by index — the playing item is
#    unchanged and the reply is the standard playing snapshot.
# ===========================================================================
echo "-- set audio / subtitle"
b=$(setas '{"audio":0}')
eq "set audio:0 is not an error" false "$(res_err "$b")"
body=$(res_body "$b")
eq "audio snapshot still plays the movie" "$file" "$(g "$body" '.nowplaying.file')"
eq "audio snapshot state is playing"      playing "$(g "$body" '.state')"

# ===========================================================================
# 6. subtitle by index (only if the item carries one) then subtitle off —
#    both leave the same item playing.
# ===========================================================================
if [ "$nsub" -ge 1 ]; then
  b=$(setas '{"subtitle":0}')
  eq "set subtitle:0 is not an error" false "$(res_err "$b")"
  eq "subtitle snapshot state is playing" playing "$(g "$(res_body "$b")" '.state')"
else
  echo "   (no embedded subtitle — index assertion skipped)"
fi

b=$(setas '{"subtitle":"off"}')
eq "set subtitle:\"off\" is not an error" false "$(res_err "$b")"
body=$(res_body "$b")
eq "subtitle-off snapshot still plays the movie" "$file" "$(g "$body" '.nowplaying.file')"
eq "subtitle-off snapshot state is playing"      playing "$(g "$body" '.state')"

# Both selectors at once on the same call.
b=$(setas '{"audio":0,"subtitle":"off"}')
eq "set audio + subtitle together is not an error" false "$(res_err "$b")"
eq "combined snapshot state is playing" playing "$(g "$(res_body "$b")" '.state')"

# ===========================================================================
# 7. Cleanup via the `stop` tool.
# ===========================================================================
echo "-- stop"
b=$(stop_t '{}')
eq "stop is not an error" false "$(res_err "$b")"
eq "stop reports the stopped state" stopped "$(g "$(res_body "$b")" '.state')"

mk_tally "set_audio_and_subtitle functional test"
