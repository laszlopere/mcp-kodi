#!/bin/sh
# Functional test for the `rpc` escape hatch.
#
# Drives the real mcp-kodi binary over its MCP stdio transport against a live
# Kodi. `rpc` is the passthrough: it sends any JSON-RPC method and returns
# Kodi's raw `result` unshaped — but only for an instance that has opted in via
# the hand-edit-only `allow_rpc` config flag. This test exercises both
# sides of that gate:
#   - an opted-in instance: ping/echo come back verbatim, a Kodi error becomes a
#     tool error, and bad arguments are clean tool errors;
#   - an instance that has NOT opted in: `rpc` is refused before any Kodi call,
#     with an error that points at `allow_rpc`;
#   - the realistic two-box topology in one config: the local test Kodi opted in
#     (default), the remote remote not — proving the gate is keyed per-instance
#     by the `instance` argument (remote is refused without ever being contacted).
# It also checks that the gate cannot be flipped through the `instances` tool —
# the whole point of the hand-edit-only design.
#
# Because `allow_rpc` is deliberately not settable via environment overrides
# — the only way to grant it is by editing the config file — the test
# writes its own temp config.json files (opted-in and not) under a private
# XDG_CONFIG_HOME and points the server at them, rather than driving the server
# from KODI_* env like the other tests do.
#
# Preconditions (else the test SKIPs, automake exit 77):
#   - jq and curl on PATH
#   - the mcp-kodi binary built
#   - a reachable Kodi that answers JSONRPC.Ping with "pong"
#
# Target Kodi defaults to the local test instance; override via the environment:
#   KODI_HOST=127.0.0.1:8080  KODI_AUTH=user:pass  KODI_SCHEME=http
#
# Exit: 0 all assertions passed · 1 a failure · 77 skipped.

set -u

# Shared harness: target-Kodi defaults, skip gate, find_binary, kodi_rpc, the
# liveness gate, the jq helpers, and the assertion framework. See tests/lib.sh.
# (The KODI_* vars lib exports are scrubbed per-call with `env -u` below, so the
# server reads its config from the private XDG_CONFIG_HOME, not the environment.)
. "$(dirname "$0")/lib.sh"

# The second box (a remote instance) plays the "rpc disabled" role in the
# realistic two-instance config (section 5). Overridable, but it need NOT be
# reachable: the gate refuses rpc *before* any network call, so the disabled-side
# assertions hold even off the network, and remote's auth is never used.
KODI_REMOTE_HOST=${KODI_REMOTE_HOST:-kodi.example.local:8443}
KODI_REMOTE_SCHEME=${KODI_REMOTE_SCHEME:-https}

# Dependencies (jq, curl), locate the binary into $MCP, require a live Kodi.
mk_preflight

# ---- two server configs: one opted into rpc, one not ----------------------
#
# `allow_rpc` is hand-edit-only, so the test must materialise it in a config
# file. Both point at the same live Kodi; only the flag differs. A private
# XDG_CONFIG_HOME keeps the server off any real ~/.config/mcp-kodi/config.json.
WORK=$(mktemp -d) || skip "cannot mktemp"
trap 'rm -rf "$WORK"' EXIT
insecure=false
[ "$KODI_SCHEME" = https ] && insecure=true   # tolerate a self-signed test box

write_config () { # dir allow_rpc-bool
  mkdir -p "$1/mcp-kodi"
  jq -n --arg host "$KODI_HOST" --arg auth "$KODI_AUTH" --arg scheme "$KODI_SCHEME" \
        --argjson insecure "$insecure" --argjson allow "$2" \
    '{version:2, default:"local",
      instances:{local:{host:$host, auth:$auth, scheme:$scheme,
                        insecure:$insecure, allow_rpc:$allow}}}' \
    > "$1/mcp-kodi/config.json"
}
ON="$WORK/on";  write_config "$ON"  true
OFF="$WORK/off"; write_config "$OFF" false

# A single config holding BOTH boxes as the deployment really runs them: the
# local test Kodi opted into rpc (and default), the remote remote not. remote
# carries NO allow_rpc key at all — absent means disabled, the real
# production posture — and a dummy auth, since the gate refuses it pre-network.
BOTH="$WORK/both"
mkdir -p "$BOTH/mcp-kodi"
remote_insecure=false
[ "$KODI_REMOTE_SCHEME" = https ] && remote_insecure=true
jq -n --arg host "$KODI_HOST" --arg auth "$KODI_AUTH" --arg scheme "$KODI_SCHEME" \
      --argjson insecure "$insecure" \
      --arg rhost "$KODI_REMOTE_HOST" --arg rscheme "$KODI_REMOTE_SCHEME" \
      --argjson rinsecure "$remote_insecure" \
  '{version:2, default:"local",
    instances:{
      local:  {host:$host,  auth:$auth,           scheme:$scheme,  insecure:$insecure,  allow_rpc:true},
      remote: {host:$rhost, auth:"unused:unused", scheme:$rscheme, insecure:$rinsecure}
    }}' \
  > "$BOTH/mcp-kodi/config.json"

# ---- talking to the server under test (MCP over stdio) --------------------

# Feed `initialize` + one `tools/call`, echo back the tool result object for
# request id 2. The server reads its config at startup from XDG_CONFIG_HOME, so
# $1 selects which config (opted-in or not) this call runs under. One invocation
# per call keeps every assertion isolated (the server exits on stdin EOF).
mcp_tool_cfg () { # xdg name arguments-json  ->  tool result object
  printf '%s\n%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{}}}' \
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$2\",\"arguments\":$3}}" \
    | env -u KODI_HOST -u KODI_AUTH -u KODI_SCHEME XDG_CONFIG_HOME="$1" "$MCP" 2>/dev/null \
    | jq -c 'select(.id==2) | .result'
}

# The `tools/list` entry for one tool, under a given config.
mcp_tool_schema () { # xdg name  ->  the tool's inputSchema
  printf '%s\n%s\n' \
    '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{}}}' \
    '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
    | env -u KODI_HOST -u KODI_AUTH -u KODI_SCHEME XDG_CONFIG_HOME="$1" "$MCP" 2>/dev/null \
    | jq -c "select(.id==2) | .result.tools[] | select(.name==\"$2\") | .inputSchema"
}

rpc_on  () { mcp_tool_cfg "$ON"  rpc "$1"; }   # arguments-json -> result object
rpc_off () { mcp_tool_cfg "$OFF" rpc "$1"; }   # arguments-json -> result object

echo "rpc functional test — Kodi at $KODI_SCHEME://$KODI_HOST, binary $MCP"

# ===========================================================================
# 1. The gate: an instance that has NOT opted in refuses rpc, before any
#    Kodi call, with an error that points the user at allow_rpc.
# ===========================================================================
echo "-- gate: disabled instance"

b=$(rpc_off '{"method":"JSONRPC.Ping"}')
eq       "rpc on a non-opted-in instance is an error" true "$(res_err "$b")"
contains "disabled error names allow_rpc"  "allow_rpc" "$(g "$(res_body "$b")" '.error')"

# The escape hatch must not be grantable through the instances tool: a `set`
# trying to flip allow_rpc on is ignored, so rpc stays disabled.
b=$(mcp_tool_cfg "$OFF" instances '{"action":"set","key":"local","allow_rpc":true}')
eq "instances set is not an error" false "$(res_err "$b")"
got=$(res_body "$b" | jq -r '.instances[] | select(.key=="local") | .allow_rpc')
eq "instances set cannot enable allow_rpc" false "$got"
b=$(rpc_off '{"method":"JSONRPC.Ping"}')
eq "rpc still disabled after a set attempt" true "$(res_err "$b")"

# ===========================================================================
# 2. The hatch itself, on an opted-in instance.
# ===========================================================================
echo "-- opted-in instance"

# 2a. Raw result, verbatim: JSONRPC.Ping → the bare string "pong" (not shaped
#     into an object), proving rpc returns Kodi's result untouched.
b=$(rpc_on '{"method":"JSONRPC.Ping"}')
eq "ping is not an error"            false   "$(res_err "$b")"
eq "ping returns the raw \"pong\""   '"pong"' "$(res_text "$b")"

# 2b. params passed straight through: ask for known Application properties and
#     read them back out of the raw result object.
b=$(rpc_on '{"method":"Application.GetProperties","params":{"properties":["volume","muted","version"]}}')
eq      "GetProperties is not an error"        false "$(res_err "$b")"
pb=$(res_body "$b")
is_true "raw result carries version.major"     "$(j "$pb" '(.version.major // 0) > 0')"
is_true "raw result carries a muted boolean"   "$(j "$pb" '(.muted | type) == "boolean"')"

# 2c. A Kodi-side error surfaces as a tool error (isError:true), not a crash.
b=$(rpc_on '{"method":"NoSuch.Method"}')
eq       "unknown method -> tool error"  true "$(res_err "$b")"
contains "error mentions Kodi"           "Kodi error" "$(g "$(res_body "$b")" '.error')"

# ===========================================================================
# 3. Argument validation — clean tool errors, never a crash or a Kodi call.
# ===========================================================================
echo "-- argument validation"

b=$(rpc_on '{}')
eq       "missing method -> tool error"  true "$(res_err "$b")"
contains "missing-method error names method" "method" "$(g "$(res_body "$b")" '.error')"

b=$(rpc_on '{"method":"JSONRPC.Ping","params":[1,2]}')
eq       "non-object params -> tool error" true "$(res_err "$b")"
contains "params error names params"       "params" "$(g "$(res_body "$b")" '.error')"

# An explicit null params is tolerated — same as omitting it (a method that
# needs none still runs): JSONRPC.Ping returns the raw "pong", not an error.
b=$(rpc_on '{"method":"JSONRPC.Ping","params":null}')
eq "null params is not an error"   false    "$(res_err "$b")"
eq "null params still returns pong" '"pong"' "$(res_text "$b")"

# An empty method string is treated as missing, not passed to Kodi.
b=$(rpc_on '{"method":""}')
eq       "empty method -> tool error"  true "$(res_err "$b")"
contains "empty-method error names method" "method" "$(g "$(res_body "$b")" '.error')"

# A method whose REQUIRED params are missing is Kodi's to reject: its -32602
# surfaces as a clean tool error (isError:true), not a crash.
b=$(rpc_on '{"method":"Application.GetProperties"}')
eq       "missing required params -> tool error" true "$(res_err "$b")"
contains "missing-required-params error mentions Kodi" "Kodi error" \
         "$(g "$(res_body "$b")" '.error')"

# ===========================================================================
# 4. Discoverability: `instances get` reports allow_rpc, and the rpc schema
#    advertises which instances currently permit the hatch.
# ===========================================================================
echo "-- discoverability"

b=$(mcp_tool_cfg "$ON" instances '{"action":"get"}')
got=$(res_body "$b" | jq -r '.instances[] | select(.key=="local") | .allow_rpc')
eq "instances get reports allow_rpc:true" true "$got"

schema=$(mcp_tool_schema "$ON" rpc)
contains "rpc schema names the permitted instance" "local" \
         "$(printf '%s' "$schema" | jq -r '.properties.method.description')"

# ===========================================================================
# 5. Realistic two-instance topology in ONE config: local opted-in (default),
#    remote remote not. Proves the gate is keyed per-instance by the `instance`
#    argument — local plays, remote is refused. remote is never contacted: the
#    gate refuses before any Kodi call, so these hold even off the network.
# ===========================================================================
echo "-- two-instance: local on (default), remote off"

# Default instance is local → opted-in → raw pong from the live test box.
b=$(mcp_tool_cfg "$BOTH" rpc '{"method":"JSONRPC.Ping"}')
eq "rpc on the default (local) is not an error"  false    "$(res_err "$b")"
eq "default rpc returns the raw \"pong\""         '"pong"' "$(res_text "$b")"

# Explicit local → same.
b=$(mcp_tool_cfg "$BOTH" rpc '{"instance":"local","method":"JSONRPC.Ping"}')
eq "rpc on explicit local returns raw \"pong\""   '"pong"' "$(res_text "$b")"

# Explicit remote → refused by the gate, before any network call, with an error
# that names both the instance and the flag to set.
b=$(mcp_tool_cfg "$BOTH" rpc '{"instance":"remote","method":"JSONRPC.Ping"}')
eq       "rpc on remote is refused"               true "$(res_err "$b")"
contains "remote refusal names allow_rpc"         "allow_rpc" "$(g "$(res_body "$b")" '.error')"
contains "remote refusal names the instance"      "remote"    "$(g "$(res_body "$b")" '.error')"

# instances get reflects the split posture: local on, remote (no key) reported off.
b=$(mcp_tool_cfg "$BOTH" instances '{"action":"get"}')
pb=$(res_body "$b")
eq "instances get: local allow_rpc:true"   true  "$(printf '%s' "$pb" | jq -r '.instances[]|select(.key=="local")|.allow_rpc')"
eq "instances get: remote allow_rpc:false" false "$(printf '%s' "$pb" | jq -r '.instances[]|select(.key=="remote")|.allow_rpc')"

# The rpc schema advertises the permitted instance (local), guiding the model.
schema=$(mcp_tool_schema "$BOTH" rpc)
contains "rpc schema names local as permitted" "local" \
         "$(printf '%s' "$schema" | jq -r '.properties.method.description')"

mk_tally "rpc functional test"
