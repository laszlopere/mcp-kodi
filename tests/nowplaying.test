#!/bin/sh
# Functional test for the `nowplaying` tool.
#
# Drives the real mcp-kodi binary over its MCP stdio transport against a live
# Kodi. `nowplaying` is a READ-ONLY probe: it fires no Input.ExecuteAction and
# changes nothing — it just returns the player_state() snapshot, doubling as a
# reachability check. The test asserts it over both states: idle (nothing
# loaded -> state "stopped") and playing (a discovered file -> state "playing"
# with a matching nowplaying.file), and that two back-to-back calls agree
# (read-only: no side effects). It restores the player to stopped on exit.
#
# Preconditions (else the test SKIPs, automake exit 77):
#   - jq and curl on PATH
#   - the mcp-kodi binary built
#   - a reachable Kodi that answers JSONRPC.Ping with "pong"
#   - at least one playable movie or song (else the playing-state half is skipped)
#
# Target Kodi defaults to the local test instance; override via the environment:
#   KODI_HOST=127.0.0.1:8080  KODI_AUTH=user:pass  KODI_SCHEME=http
#
# Exit: 0 all assertions passed · 1 a failure · 77 skipped.

set -u

# Shared harness. See tests/lib.sh.
. "$(dirname "$0")/lib.sh"

# Keep any playback this test triggers OUT of the user's real history log.
# (EXIT cleanup is folded into the volume guard's trap, set below.)
STATE_DIR=$(mktemp -d) || skip "cannot mktemp"
export XDG_STATE_HOME="$STATE_DIR"

mk_preflight

# ---- volume guard ----------------------------------------------------------
vol0=$(kodi_rpc Application.GetProperties '{"properties":["volume"]}' \
        | jq -r '.result.volume // empty')
restore_volume () {
  [ -n "$vol0" ] && kodi_rpc Application.SetVolume "{\"volume\":$vol0}" >/dev/null 2>&1
}
trap 'restore_volume; rm -rf "$STATE_DIR"' EXIT
[ -n "$vol0" ] && kodi_rpc Application.SetVolume '{"volume":2}' >/dev/null 2>&1

# Tool wrappers.
nowplaying  () { mcp_tool nowplaying  "$1"; }
playfile    () { mk_playfile          "$1"; }  # transient-tolerant (see lib.sh)
searchmedia () { mcp_tool searchmedia "$1"; }

echo "nowplaying functional test — Kodi at $KODI_SCHEME://$KODI_HOST, binary $MCP"

# ===========================================================================
# 1. Caller mistakes: an unconfigured instance is a clean tool error with the
#    no_instance category and a setup hint.
# ===========================================================================
echo "-- errors / edges"
b=$(nowplaying '{"instance":"no-such-box"}')
eq "unknown instance -> tool error" true "$(res_err "$b")"
eq "unknown instance -> category no_instance" no_instance \
   "$(g "$(res_body "$b")" '.category')"
is_true "unknown instance -> carries a setup hint" \
        "$(j "$(res_body "$b")" 'has("hint") and (.hint|length>0)')"

# ===========================================================================
# 2. Idle: with nothing loaded, the probe reports state "stopped" and changes
#    nothing (Kodi still reports no active player afterwards).
# ===========================================================================
echo "-- idle (nothing playing)"
mk_wait_idle
b=$(nowplaying '{}')
eq "idle probe is not an error" false "$(res_err "$b")"
pb=$(res_body "$b")
is_true "snapshot reports a state field" "$(j "$pb" 'has("state")')"
eq      "idle state is stopped"          stopped "$(g "$pb" '.state')"
eq      "probe started no player" 0 \
        "$(kodi_rpc Player.GetActivePlayers '{}' | jq -r '.result | length')"

# ===========================================================================
# 3. Discover a playable file (movie, else a song) for the playing-state half.
# ===========================================================================
file=""
b=$(res_body "$(searchmedia '{"type":"movie","limit":1}')")
if [ "$(j "$b" '.returned >= 1')" = true ]; then
  file=$(g "$b" '.rows[0].file')
else
  artist=$(kodi_rpc AudioLibrary.GetArtists '{"limits":{"start":0,"end":1}}' \
            | jq -r '.result.artists[0].artist // empty')
  if [ -n "$artist" ]; then
    b=$(res_body "$(searchmedia "$(jargs --arg a "$artist" '{type:"music",artist:$a,limit:1}')")")
    [ "$(j "$b" '.returned >= 1')" = true ] && file=$(g "$b" '.rows[0].file')
  fi
fi

if [ -z "$file" ]; then
  echo "   (no playable movie or song in library — playing-state assertions skipped)"
  mk_tally "nowplaying functional test"
fi

# ===========================================================================
# 4. Playing: start a file (via playfile, not the probe), then assert the probe
#    reflects it — and that a second probe agrees (read-only, no side effects).
# ===========================================================================
echo "-- playing"
echo "   (file: $file)"
playfile "$(jargs --arg f "$file" '{file:$f}')" >/dev/null

b=$(nowplaying '{}')
eq "playing probe is not an error" false "$(res_err "$b")"
pb=$(res_body "$b")
eq "state is playing"                  playing "$(g "$pb" '.state')"
eq "snapshot names the playing file"   "$file" "$(g "$pb" '.nowplaying.file')"
is_true "snapshot carries a non-empty totaltime" \
        "$(j "$pb" '(.totaltime // {}) | (.hours+.minutes+.seconds+.milliseconds) > 0')"

# Read-only: a second probe reports the same file and leaves the player running.
pb2=$(res_body "$(nowplaying '{}')")
eq "repeat probe reports the same file" "$file" "$(g "$pb2" '.nowplaying.file')"
eq "repeat probe reports still playing" playing "$(g "$pb2" '.state')"
is_true "player still active after probing" \
        "$([ "$(kodi_rpc Player.GetActivePlayers '{}' | jq -r '.result | length')" -ge 1 ] && echo true || echo false)"

# Cleanup: leave the player stopped (the safe neutral state).
mk_wait_idle

mk_tally "nowplaying functional test"
